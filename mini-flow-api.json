{
  "name": "Mini Flow",
  "apiVersion": 1,
  "description": "Read and update the current flowchart through page JavaScript when permitted by the agent's browser tools and the user's request.",
  "instance": "window.miniFlowEditor",
  "library": "window.MiniFlow",
  "documentation": "./agent-guide.md",
  "repository": "https://github.com/KakkoiDev/mini-flow",
  "projectSchema": {
    "type": "object",
    "required": [
      "version",
      "source",
      "positions"
    ],
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": 1
      },
      "source": {
        "type": "string",
        "description": "Mini Flow Mermaid subset, including optional %% mini-flow metadata for notes, attachments, and bends."
      },
      "positions": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  },
  "updateOptionsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string",
        "description": "Brief human-readable explanation displayed after an update."
      },
      "highlight": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "methods": {
    "getProject": {
      "arguments": [],
      "returns": {
        "$ref": "#/projectSchema"
      },
      "readOnly": true
    },
    "getMermaid": {
      "arguments": [],
      "returns": {
        "type": "string"
      },
      "readOnly": true
    },
    "setProject": {
      "arguments": [
        {
          "name": "project",
          "schema": {
            "$ref": "#/projectSchema"
          }
        },
        {
          "name": "options",
          "optional": true,
          "schema": {
            "$ref": "#/updateOptionsSchema"
          }
        }
      ],
      "effects": "Replace board, notify host persistence, highlight changes for three seconds, and create one undo step."
    },
    "setMermaid": {
      "arguments": [
        {
          "name": "source",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "options",
          "optional": true,
          "schema": {
            "$ref": "#/updateOptionsSchema"
          }
        }
      ],
      "effects": "Replace diagram structure while preserving saved or matching node positions. The demo uses Dagre if no positions are available. Custom Mini Flow metadata carries notes and bends."
    },
    "autoLayout": {
      "arguments": [
        {
          "name": "options",
          "optional": true,
          "schema": {
            "$ref": "#/updateOptionsSchema"
          }
        }
      ],
      "effects": "Arrange nodes and notes with Dagre, fit the result, and create one Undo step. Requires Dagre in the mount options."
    },
    "undo": {
      "arguments": [],
      "effects": "Undo one diagram edit."
    },
    "redo": {
      "arguments": [],
      "effects": "Redo one diagram edit."
    },
    "fit": {
      "arguments": [],
      "effects": "Fit the current board into the viewport."
    },
    "exportMarkdown": {
      "arguments": [],
      "returns": {
        "type": "string"
      },
      "readOnly": true
    },
    "exportSvg": {
      "arguments": [],
      "returns": {
        "javascriptType": "Blob"
      },
      "readOnly": true
    },
    "exportPng": {
      "arguments": [],
      "returns": {
        "javascriptType": "Promise<Blob>"
      },
      "readOnly": true
    }
  },
  "applyLink": {
    "fragment": "#apply=<percent-encoded JSON>",
    "schema": {
      "type": "object",
      "required": [
        "version",
        "base",
        "project",
        "message"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "base": {
          "$ref": "#/projectSchema"
        },
        "project": {
          "$ref": "#/projectSchema"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "effects": "Open a review dialog. Apply updates the board with SDK feedback and Undo if it matches the base project."
  },
  "webmcp": {
    "module": "./mini-flow-webmcp.js",
    "tools": {
      "get_board": {
        "readOnly": true,
        "returns": {
          "tabId": "Internal ID of the current page instance",
          "revision": "Tab-scoped revision",
          "project": {
            "$ref": "#/projectSchema"
          }
        }
      },
      "apply_board_edit": {
        "inputSchema": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "rename_node"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]*$"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "op",
                      "id",
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "delete_node"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]*$"
                      }
                    },
                    "required": [
                      "op",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "move_node"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]*$"
                      },
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "required": [
                      "op",
                      "id",
                      "position"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "add_node"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]*$"
                      },
                      "type": {
                        "enum": [
                          "terminal",
                          "step",
                          "decision",
                          "note"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "required": [
                      "op",
                      "id",
                      "type",
                      "label",
                      "position"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "add_arrow"
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]*$"
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^[A-Za-z][\\w-]*$"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "op",
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "revision",
            "edits",
            "message"
          ],
          "additionalProperties": false
        },
        "effects": "Apply one undoable batch to the current tab if its revision matches."
      }
    }
  },
  "agentRoom": {
    "module": "./mini-flow-agent-room.js",
    "about": "Ask AI sends requests to agents in an agent-room chat room (github.com/KakkoiDev/agent-room). The board owner connects under Live session → AI agents.",
    "request": "An @mention of the agent with the note, its recent conversation, and the board as Mermaid with block positions, up to 12 KB.",
    "editBlock": "To change the board, reply with one fenced block named mini-flow-edit containing {\"message\": string, \"edits\": [...]}, using the add_node, add_arrow, rename_node, move_node and delete_node operations of apply_board_edit.",
    "review": "The owner reviews edits before they apply unless review is turned off."
  }
}
